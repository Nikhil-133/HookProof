# HookProof environment template.
# Copy to .env for local development:  Copy-Item .env.example .env
#
# These are DEVELOPMENT-ONLY placeholders for the synthetic local lab.
# NEVER use real payment credentials. NEVER use these values in production.

# Shared HMAC secret used to sign and verify synthetic webhook events.
HOOKPROOF_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Separate bearer token required by the restricted test-state interface.
HOOKPROOF_TEST_TOKEN=dev-test-token-change-me

# Accepted timestamp freshness window in seconds (protects against replay).
HOOKPROOF_FRESHNESS_WINDOW=300

# Default lab bind address / port (loopback only).
HOOKPROOF_LAB_HOST=127.0.0.1
HOOKPROOF_LAB_PORT=8000

# Optional: path to an explicit env file loaded by the CLI.
# HOOKPROOF_ENV_FILE=.env
